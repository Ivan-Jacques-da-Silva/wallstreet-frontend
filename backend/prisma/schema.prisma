// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nome      String
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sala {
  id           Int      @id @default(autoincrement())
  numero       String
  andar        Int
  nome         String
  area         Float
  posicao      String
  orientacao   String?
  preco        Float
  disponivel   Boolean  @default(true)
  imagem       String?
  planta       String?
  proposta     String?
  valorizacao  Float?
  lucro        Float?
  aluguel      Float?
  condominio   Float?
  iptu         Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PreReserva {
  id        Int      @id @default(autoincrement())
  nome      String
  cpf_cnpj  String
  contato   String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contraproposta {
  id        Int      @id @default(autoincrement())
  nome      String
  cpf_cnpj  String
  contato   String
  email     String
  proposta  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgendamentoReuniao {
  id        Int      @id @default(autoincrement())
  nome      String
  cpf_cnpj  String
  contato   String
  email     String
  data      String
  hora      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Formulario {
  id           Int      @id @default(autoincrement())
  tipo         String   // 'pre-reserva', 'contraproposta', 'agendamento'
  nome         String
  cpf_cnpj     String
  contato      String
  email        String
  proposta     String?
  data         String?
  hora         String?
  status       String   @default("pendente")
  visualizado  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
